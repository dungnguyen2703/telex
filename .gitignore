# Build output.
#
# Note the patterns are "dir/*" and not "dir/": git cannot re-include a file
# whose parent directory is excluded, and we need exactly one exception —
# the prebuilt download at the bottom of this file.
windows/build/*
macos/build/*
macos/.build/

*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.o

# Written by telex at runtime, next to the exe
exclude.txt

# Editor / OS noise
.vs/
*.user
Thumbs.db
desktop.ini
.DS_Store


!windows/build/telex.exe
!macos/build/telex.app
